NODE_ENV=development

# Where the API listens. Keep it on localhost behind a reverse proxy in production.
HOST=localhost
PORT=3000

# Comma separated list of frontend origins allowed to use the API from a browser
# (also trusted by Better Auth). Requests that change data from any other origin
# get a 403; in production a missing Origin header is rejected too.
# Production: https only, e.g. https://timeline.example.ch
CORS_ORIGINS=http://localhost:5173

# Database. DB_DRIVER selects the data layer implementation (only "postgres" for now).
DB_DRIVER=postgres
POSTGRES_USER=timeline
POSTGRES_PASSWORD=supersecretpgpw
POSTGRES_DB=timeline
POSTGRES_PORT=5432
DATABASE_URL=postgresql://timeline:supersecretpgpw@localhost:5432/timeline
# Direct (non-pooled) connection for migrations. Optional locally; on Neon use the
# connection string without "-pooler" (the Neon integration sets this for you).
# DATABASE_URL_UNPOOLED=

# Auth mode:
# - dev:         every request is the dev user below, an admin. No login needed.
#                Refused when NODE_ENV=production.
# - better-auth: Google sign-in, gated by access codes.
AUTH_MODE=dev
DEV_USER_ID=dev-user
DEV_USER_NAME=Dev User

# Required for AUTH_MODE=better-auth.
# Secret: at least 32 characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public URL of this backend. Google redirects to <BETTER_AUTH_URL>/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Created once on startup as a one-time admin code, so the first admin can sign up.
INITIAL_ACCESS_CODE=ABCD-EFGH-JKLM

# Read the client IP from X-Forwarded-For for rate limiting. Only enable behind
# a proxy you control (Caddy), otherwise clients can fake their IP.
# Not needed on Vercel (detected through the VERCEL variable Vercel sets).
TRUST_PROXY=false

# Maximum accepted request body size in bytes (default 1 MB).
BODY_LIMIT_BYTES=1048576
