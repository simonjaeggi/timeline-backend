{
  "name": "timeline-backend",
  "version": "0.1.0",
  "description": "Backend for a family timeline application (Hono + Zod + Drizzle).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18 <27"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/node-server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/node-server.js",
    "typecheck": "tsc --noEmit",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "db:up": "docker compose -f db/docker-compose.yml --env-file .env up -d",
    "db:down": "docker compose -f db/docker-compose.yml --env-file .env down",
    "db:delete": "docker compose -f db/docker-compose.yml --env-file .env down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.19",
    "@vercel/functions": "^3.11.1",
    "better-auth": "1.7.22",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
